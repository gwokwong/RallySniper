# 【生产】环境变量

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = ./

# API 地址前缀（部署到服务器时二选一）：
#   ① 留空/斜杠 = 同源相对路径，需 nginx 反代 /api → 127.0.0.1:8000（推荐，见 DEPLOY.md）
#   ② 直连 = http://服务器IP:8000（后端 CORS 已放开，无需反代；改完需重新 npm run build）
VITE_API_URL = /gupiao/

# Delete console
VITE_DROP_CONSOLE = true
# vite preview 本地预览的 /api 代理目标（不影响构建产物，仅 preview/dev 用）
VITE_API_PROXY_URL = http://127.0.0.1:8000
